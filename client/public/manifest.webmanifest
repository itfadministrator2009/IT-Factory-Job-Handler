{
  "name": "IT Factory Work Desk",
  "short_name": "Work Desk",
  "description": "Jobs, assets, storage and timesheets for IT Factory.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f5f1",
  "theme_color": "#155e6b",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My Timesheet", "url": "/timecard", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Jobs", "url": "/jobs", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
